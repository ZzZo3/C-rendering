float matrixTransform(float p, char axis) {
  if (p==0) { return 0;}
  if (axis=='x') {
    p += (2*p*p*p)/(abs(p)*xDim);
    p /= 2;
  } else if (axis=='y') {
    p += (2*p*p*p)/(abs(p)*xDim);
    p /= -2;
  }
  return p;
};

